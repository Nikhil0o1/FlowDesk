# ============================================================
# FlowDesk — single root environment file (copy to .env)
# Loaded by the backend (pydantic-settings) and by Vite (VITE_* vars only)
# ============================================================

# --- App ---
APP_NAME=FlowDesk
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database ---
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/flowdesk
# Or the dockerized Postgres from docker-compose.yml (port 5433):
# DATABASE_URL=postgresql+psycopg2://flowdesk:flowdesk@localhost:5433/flowdesk

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITE_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Google SSO (same OAuth client id for both vars) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# --- SMTP (Mailpit for local dev: docker compose up -d mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=FlowDesk <no-reply@flowdesk.dev>
EMAIL_ENABLED=true

# --- File storage ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
# S3 (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- GitHub App ---
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Jobs ---
ABANDONED_TIMER_MAX_HOURS=8
SCHEDULER_ENABLED=true

# --- Platform superadmin bootstrap (created by seed script) ---
SUPERADMIN_EMAIL=admin@flowdesk.dev
SUPERADMIN_PASSWORD=SuperAdmin123!
