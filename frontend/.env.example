# ---- FlowDesk UI environment ----

# API origin. Leave EMPTY for local dev (the Vite dev server proxies /api and
# the WebSocket to http://localhost:8000). In production (Vercel) set it to
# the deployed API, e.g. https://flowdesk-api.onrender.com
VITE_API_URL=

# Google OAuth web client id — enables the "Continue with Google" login button.
# Must be the same client the API uses (GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=
