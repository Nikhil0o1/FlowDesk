# Production split deploy: set to your API origin (e.g. https://flowdesk-api-mvwt.onrender.com).
# Leave empty on flowdesk.brightcone.ai — resolved automatically at runtime.
VITE_API_URL=

# Direct backend for dev WebSockets (avoids Vite ws-proxy errors on API reload).
VITE_BACKEND_URL=http://localhost:8000

# Same web client ID as GOOGLE_CLIENT_ID on the API.
# Google Cloud Console → OAuth client → Authorized JavaScript origins:
#   http://localhost:5173
# (Use localhost — not 127.0.0.1 — the dev server redirects loopback for GIS.)
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT=common

VITE_CLARITY_ID=
