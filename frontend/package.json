{
  "name": "flowdesk-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:smoke:ci": "node scripts/run-smoke-ci.mjs",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage tests/unit tests/integration tests/security",
    "test:ci": "vitest run --coverage tests/unit tests/integration tests/security && npm run test:smoke:ci",
    "sync:coverage-summary": "node scripts/sync-coverage-summary.mjs",
    "sync:deploy-headers": "node scripts/sync-deploy-headers.mjs",
    "verify:production-headers": "node scripts/verify-production-headers.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:ci": "npm audit --audit-level=moderate",
    "audit:critical": "npm audit --audit-level=critical",
    "security:local": "npm run audit:ci && npm run audit:critical && npm run verify:deps && npm run verify:third-party && npm run test:security",
    "security:scan": "bash scripts/security-scan.sh",
    "verify:deps": "vitest run tests/security/dependencies.security.test.ts",
    "verify:third-party": "vitest run tests/security/thirdParty.security.test.ts tests/security/clarity.test.ts tests/security/securityHeaders.test.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.14.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.2.8",
    "@tanstack/react-query": "^5.59.16",
    "framer-motion": "^12.42.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "lodash-es": "^4.18.1",
    "nanoid": "^3.3.12",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.15"
    }
  }
}
