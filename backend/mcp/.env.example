# FlowDesk API (no /api/v1 suffix required)
FLOWDESK_API_URL=http://localhost:8000

# Public URL of this MCP HTTP server (used in OAuth metadata + server icon)
MCP_PUBLIC_URL=http://localhost:3100

# HTTP bind
MCP_PORT=3100
MCP_BIND_HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost

# Optional: allow flowdesk_delete_task
FLOWDESK_ALLOW_DESTRUCTIVE=false
