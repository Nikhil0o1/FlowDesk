ENVIRONMENT=development
DEBUG=true
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Optional: comma-separated extra CORS origins (e.g. preview/staging UI domains).
# Production split deploy: set FRONTEND_URL to your canonical UI (https://flowdesk.brightcone.ai).
CORS_ORIGINS=
DATABASE_URL=postgresql+psycopg2://postgres:<password>@localhost:5432/flowdesk
SUPERADMIN_EMAIL=brightcone.system@gmail.com
MICROSOFT_TENANT=common
# Google OAuth — register in Google Cloud Console → Credentials → OAuth client:
#   Authorized JavaScript origins (GIS login button):
#     http://localhost:5173
#     https://<your-production-ui-domain>
#   Authorized redirect URIs (server-side OAuth flows):
#     {BACKEND_URL}/api/v1/auth/google/callback
#     {BACKEND_URL}/api/v1/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
EMAIL_FROM=FlowDesk <no-reply@brightcone.ai>
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
REDIS_URL=
# PAT HMAC pepper map (JSON). Required in production. Example: {"1":"dev-pepper-change-me"}
API_KEY_PEPPERS=
# Version used when minting new fd_live_ tokens (must exist in API_KEY_PEPPERS).
API_KEY_PEPPER_CURRENT=1
# PAT_ROTATION_GRACE_SECONDS=300
# PAT_MAX_LIFETIME_DAYS=365
TRUSTED_HOSTS=
# MCP — colocated on this API service (no separate Render instance).
# Set MCP_SIDECAR_ENABLED=true in production; leave false for local dev (run mcp/ separately).
MCP_SIDECAR_ENABLED=false
MCP_SIDECAR_URL=http://127.0.0.1:3100
# Public URL of the remote MCP HTTP server (Streamable HTTP). When empty, defaults to {BACKEND_URL}/mcp.
# Production (colocated): leave empty — defaults to https://flowdesk-api-mvwt.onrender.com/mcp
# Never set to localhost in production.
MCP_PUBLIC_URL=
# Outbound webhooks — set to true ONLY in local dev to allow localhost/private target URLs.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# WEBHOOK_MAX_PER_ORG=20
# WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# WEBHOOK_AUTO_DISABLE_THRESHOLD=10
# WEBHOOK_DELIVERY_RETENTION_DAYS=90
# WEBHOOK_SECRET_GRACE_SECONDS=86400
# WEBHOOK_RECONCILE_STALE_MINUTES=10
# WEBHOOK_API_VERSION=2026-07-14
# WEBHOOK_MAX_ATTEMPTS=6

# WebSocket / realtime
# WS_TICKET_TTL_SECONDS=60
# WS_MAX_CONNECTIONS_PER_USER=10
# WS_MAX_CONNECTIONS_PER_TOKEN=5
# WS_MAX_INTEGRATION_CONNECTIONS_PER_USER=5
# WS_IDLE_TIMEOUT_SECONDS=90
# WS_SKIP_ORIGIN_CHECK=false